{
  "name": "ccpet",
  "version": "2.0.0",
  "description": "Claude Code 桌面宠物 - 带状态感知的互动桌宠",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "notify": "node hooks/notify.js",
    "build": "electron-packager . Clawd --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --ignore=\"^/dist\" --ignore=\"^/assets/make_.*\\.py$\" --ignore=\"^/renderer/spritesheet1\\.webp$\"",
    "hooks:install": "node scripts/setup-hooks.js install",
    "hooks:uninstall": "node scripts/setup-hooks.js uninstall"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron"
  ],
  "author": "CCPet",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "ccusage": "^20.0.20"
  }
}
